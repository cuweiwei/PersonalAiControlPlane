{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-control-plane.local/schemas/identity/v1/action-grant.schema.json",
  "title": "Personal AI Control Plane action grant",
  "type": "object",
  "additionalProperties": false,
  "required": ["header", "claims"],
  "properties": {
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "typ", "kid"],
      "properties": {
        "alg": { "const": "EdDSA" },
        "typ": { "const": "pai-action+jwt" },
        "kid": { "type": "string", "minLength": 1 }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iss", "sub", "aud", "jti", "iat", "nbf", "exp", "taskId", "attemptId", "planDigest", "policyVersion", "fencingToken", "actions", "resources", "capabilityIds", "budget", "sandbox", "hardStopApprovalId"],
      "properties": {
        "iss": { "type": "string", "minLength": 1 },
        "sub": { "type": "string", "minLength": 1 },
        "aud": { "type": "string", "minLength": 1 },
        "jti": { "type": "string", "minLength": 1 },
        "iat": { "type": "integer" },
        "nbf": { "type": "integer" },
        "exp": { "type": "integer" },
        "taskId": { "type": "string", "minLength": 1 },
        "attemptId": { "type": "string", "minLength": 1 },
        "planDigest": { "type": "string", "minLength": 1 },
        "policyVersion": { "type": "integer", "minimum": 1 },
        "fencingToken": { "type": "integer", "minimum": 0 },
        "actions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "resources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "capabilityIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "budget": { "type": "object" },
        "sandbox": { "type": "object" },
        "hardStopApprovalId": { "type": ["string", "null"] }
      }
    }
  }
}
