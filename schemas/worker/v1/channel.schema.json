{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-control-plane.local/schemas/worker/v1/channel.schema.json",
  "title": "WorkerChannelV1",
  "oneOf": [
    { "$ref": "#/$defs/enrollmentRequest" },
    { "$ref": "#/$defs/enrollmentFinalize" },
    { "$ref": "#/$defs/pollRequest" },
    { "$ref": "#/$defs/eventRequest" },
    { "$ref": "#/$defs/rotateRequest" }
  ],
  "$defs": {
    "workerId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "credential": { "type": "string", "pattern": "^[A-Za-z0-9_-]{32,256}$" },
    "enrollmentRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["publicKeyPem", "deviceSummary"],
      "properties": { "publicKeyPem": { "type": "string", "minLength": 20, "maxLength": 20000 }, "deviceSummary": { "type": "object", "additionalProperties": true } }
    },
    "enrollmentFinalize": {
      "type": "object", "additionalProperties": false,
      "required": ["challenge", "serverNonce", "workerSignature"],
      "properties": { "challenge": { "type": "string", "minLength": 16, "maxLength": 256 }, "serverNonce": { "type": "string", "minLength": 16, "maxLength": 256 }, "workerSignature": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" } }
    },
    "pollRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["workerId", "credential", "connectionId"],
      "properties": { "workerId": { "$ref": "#/$defs/workerId" }, "credential": { "$ref": "#/$defs/credential" }, "connectionId": { "type": "string", "minLength": 1, "maxLength": 200 }, "hello": { "$ref": "./envelope.schema.json" } }
    },
    "eventRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["workerId", "credential", "frame"],
      "properties": { "workerId": { "$ref": "#/$defs/workerId" }, "credential": { "$ref": "#/$defs/credential" }, "frame": { "$ref": "./envelope.schema.json" } }
    },
    "rotateRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["workerId", "credential"],
      "properties": { "workerId": { "$ref": "#/$defs/workerId" }, "credential": { "$ref": "#/$defs/credential" } }
    }
  }
}
