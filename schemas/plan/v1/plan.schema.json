{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-control-plane.local/schemas/plan/v1/plan.schema.json",
  "title": "Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "goalId", "revision", "intent", "acceptanceCriteria", "tasks"],
  "properties": {
    "schemaVersion": {"const": 1},
    "goalId": {"type": "string"},
    "revision": {"type": "integer", "minimum": 1},
    "intent": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "acceptanceCriteria": {"type": "array", "items": {"$ref": "#/$defs/criterion"}, "minItems": 1},
    "context": {"type": "object"},
    "estimate": {"type": "object"},
    "risk": {"type": "object"},
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}},
    "createdBy": {"type": "object"},
    "createdAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "verificationTaskId"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "verificationTaskId": {"type": "string", "minLength": 1}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "type", "title", "required", "sideEffectClass"],
      "properties": {
        "taskId": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "dependsOn": {"type": "array", "items": {"type": "string"}},
        "required": {"type": "boolean"},
        "sideEffectClass": {"enum": ["NONE", "READ_ONLY", "IDEMPOTENT_MUTATION", "NON_IDEMPOTENT_MUTATION"]},
        "capabilityRequirements": {"type": "array"},
        "budget": {"type": "object"},
        "sandbox": {"type": "object"},
        "verification": {"type": "object"},
        "rollback": {"type": ["object", "null"]}
      }
    }
  }
}
