{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-control-plane.local/schemas/archive/v1/envelope.schema.json",
  "title": "Normalized conversation envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "externalAccountHandle", "conversation", "message", "provenance", "checksum"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": { "type": "string", "minLength": 1 },
    "externalAccountHandle": { "type": "string", "minLength": 1 },
    "conversation": { "type": "object", "additionalProperties": false, "required": ["externalId", "title", "scope"], "properties": { "externalId": { "type": "string", "minLength": 1 }, "title": { "type": ["string", "null"] }, "scope": { "type": "array", "items": { "type": "string" } } } },
    "message": { "type": "object", "additionalProperties": false, "required": ["externalId", "revision", "role", "sentAt", "content"], "properties": { "externalId": { "type": "string", "minLength": 1 }, "revision": { "type": "string", "minLength": 1 }, "role": { "type": "string", "minLength": 1 }, "sentAt": { "type": ["string", "null"], "format": "date-time" }, "content": { "type": "object", "additionalProperties": false, "required": ["format", "text"], "properties": { "format": { "type": "string" }, "text": { "type": "string" } } }, "attachments": { "type": "array", "items": { "type": "object" } } } },
    "provenance": { "type": "object" },
    "checksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
