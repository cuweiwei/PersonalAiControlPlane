{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-control-plane.local/schemas/api/v2/orchestration-work.schema.json",
  "title": "Orchestration Work contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "origin",
    "objective",
    "design_authority",
    "implementation_owner",
    "design_refs",
    "workspace_id",
    "owned_paths",
    "acceptance_criteria",
    "required_tests",
    "target",
    "review",
    "resume_policy",
    "risk_tier"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "origin_ref"],
      "properties": {
        "kind": { "enum": ["HERMES", "CODEX"] },
        "origin_ref": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "objective": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "project_ref": { "type": "string", "minLength": 1, "maxLength": 500 },
    "repository_ref": { "type": "string", "minLength": 1, "maxLength": 500 },
    "phase_ref": { "type": "string", "minLength": 1, "maxLength": 500 },
    "design_authority": { "enum": ["MAC_LED", "WINDOWS_FEATURE_OWNER"] },
    "implementation_owner": { "enum": ["WINDOWS", "MAC_LOCAL", "DYNAMIC"] },
    "design_refs": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "base_commit_sha": { "type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" },
    "workspace_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "owned_paths": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000, "not": { "pattern": "^(?:/|[A-Za-z]:)|(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)" } }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 120 },
          "text": { "type": "string", "minLength": 1, "maxLength": 4000 }
        }
      }
    },
    "required_tests": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": { "enum": ["COMMAND", "CI"] },
          "command_ref": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "allOf": [
          { "if": { "properties": { "kind": { "const": "COMMAND" } } }, "then": { "required": ["command_ref"] } }
        ]
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "runtime"],
      "properties": {
        "capability": { "type": "string", "minLength": 1, "maxLength": 120 },
        "runtime": { "type": "string", "minLength": 1, "maxLength": 120 },
        "preferred_worker_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 300 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "merge_allowed"],
      "properties": {
        "owner": { "enum": ["HERMES", "CODEX"] },
        "merge_allowed": { "const": false }
      }
    },
    "resume_policy": { "enum": ["INHERIT_WORKER", "MANUAL_ONLY"] },
    "risk_tier": { "enum": ["LOW", "MEDIUM", "HIGH"] }
  }
}
