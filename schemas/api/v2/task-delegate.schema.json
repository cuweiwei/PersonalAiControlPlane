{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-control-plane.local/schemas/api/v2/task-delegate.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "idempotency_key", "source_intent_ref", "task_type", "description"],
  "properties": {
    "schema_version": { "const": 2 },
    "source": { "const": "hermes" },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 300 },
    "source_intent_ref": { "type": "string", "minLength": 1, "maxLength": 500 },
    "conversation_ref": { "type": ["string", "null"], "maxLength": 500 },
    "work_ref": { "type": ["object", "null"], "required": ["id", "revision", "owner"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "revision": { "type": "integer", "minimum": 0 }, "owner": { "type": "string" } } },
    "task_type": { "enum": ["llm.inference", "codex", "python", "command", "generic"] },
    "description": { "type": "string", "minLength": 1, "maxLength": 100000 },
    "title": { "type": "string", "maxLength": 1000 },
    "input": { "type": "object" },
    "requirements": { "type": "object" },
    "criteria": { "type": "array", "items": { "type": "object" } },
    "input_artifact_ids": { "type": "array", "items": { "type": "string" } },
    "priority": { "enum": ["low", "normal", "high", "urgent"] },
    "queue_deadline": { "type": ["string", "null"], "format": "date-time" },
    "execution_timeout_seconds": { "type": "integer", "minimum": 1 },
    "retry_policy": { "type": ["object", "null"], "required": ["max_attempts", "effect_class"], "additionalProperties": false, "properties": { "max_attempts": { "type": "integer", "minimum": 1 }, "effect_class": { "enum": ["READ_ONLY", "WORKSPACE_WRITE", "EXTERNAL_WRITE"] } } },
    "approval_ref": { "type": ["string", "null"] }
  }
}
