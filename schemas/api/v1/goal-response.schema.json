{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-control-plane.local/schemas/api/v1/goal-response.schema.json",
  "title": "GoalAdmissionResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["goalId", "status", "submittedAt", "links"],
  "properties": {
    "goalId": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
    "status": {"const": "PENDING"},
    "submittedAt": {"type": "string", "format": "date-time"},
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["self", "tasks", "events"],
      "properties": {
        "self": {"type": "string"},
        "tasks": {"type": "string"},
        "events": {"type": "string"}
      }
    }
  }
}
