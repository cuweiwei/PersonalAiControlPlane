<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.trycua.cua-driver</string>
  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_CUA_DRIVER_APP_EXECUTABLE</string>
    <string>serve</string>
    <string>--socket</string>
    <string>REPLACE_CUA_DRIVER_SOCKET</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>REPLACE_CUA_DRIVER_LOG_DIRECTORY/driver.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_CUA_DRIVER_LOG_DIRECTORY/driver-error.log</string>
</dict>
</plist>
