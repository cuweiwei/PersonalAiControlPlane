<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.personal-ai.worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_WORKER_EXECUTABLE</string>
    <string>start</string>
    <string>--origin</string>
    <string>REPLACE_ORIGIN</string>
    <string>--data-dir</string>
    <string>REPLACE_DATA_DIRECTORY</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PAI_CONTROL_PLANE_ORIGIN</key>
    <string>REPLACE_ORIGIN</string>
    <key>PAI_OMLX_ENABLED</key>
    <string>REPLACE_OMLX_ENABLED</string>
    <key>PAI_OMLX_API_KEY_FILE</key>
    <string>REPLACE_OMLX_API_KEY_FILE</string>
    <key>PAI_LMSTUDIO_ENABLED</key>
    <string>REPLACE_LMSTUDIO_ENABLED</string>
    <key>PAI_OLLAMA_ENABLED</key>
    <string>REPLACE_OLLAMA_ENABLED</string>
  </dict>
  <key>StandardOutPath</key>
  <string>REPLACE_LOG_PATH/worker.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_LOG_PATH/worker.stderr.log</string>
</dict>
</plist>
